          "name": "Team Profile",
          "request": {
            "name": "Team Profile",
            "description": {
              "content": "• This API endpoint returns detailed identity and background information for football teams.\n\n\n\n• It provides metadata such as founding dates, home venues, coaching staff, and official website links.\n\n\n\n• Use it to build comprehensive team profile pages or to display team logos and details in match-related interfaces.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sport",
                "football",
                "team"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
