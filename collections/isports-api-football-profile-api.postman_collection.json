                  "key": "leagueId",
                  "value": "<string>",
                  "description": "League ID; references League table (note: not applicable for Cup IDs)."
                },
                {
                  "disabled": false,
                  "key": "teamId",
                  "value": "<string>",
                  "description": "Team ID; references Team table."
                },
                {
                  "disabled": false,
                  "key": "day",
