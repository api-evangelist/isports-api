        {
          "id": "652663ee-c745-4d7f-a62a-2dc7d673b524",
          "name": "Schedule & Results (Basic)",
          "request": {
            "name": "Schedule & Results (Basic)",
            "description": {
              "content": "• This API endpoint returns basic schedule and result information for basketball matches. You can use it with the <a href=\"/docs.html?id=34\" style=\"color:blue\">Match Modify Record</a> endpoint to track any post-publication corrections to match data.\n\n\n\n• One of the following parameters is required: date, leagueId, or matchId — these three cannot be used together in the same request. The season parameter can only be used in combination with leagueId, to retrieve matches for a specific season; if omitted, the current season is returned by default. \n\n\n\n• Tips: You have access to all the basketball Common API endpoints with any valid paid basketball plans.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sport",
                "basketball",
                "schedule",
                "basic"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<string>",
                  "description": "Match date, format yyyy-MM-dd, e.g. 2026-07-01."
                },
                {
                  "disabled": false,
                  "key": "leagueId",
                  "value": "<string>",
                  "description": "Filter by a specific league or cup ID."
                },
                {
                  "disabled": false,
                  "key": "season",
                  "value": "<string>",
                  "description": "Used together with leagueId to retrieve matches for a specific season, e.g. 25-26. \n \n \n\nReturns the current season by default."
                },
                {
                  "disabled": false,
                  "key": "matchId",
                  "value": "<string>",
                  "description": "Filter by a specific match ID. Only matches from the current season are supported."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
