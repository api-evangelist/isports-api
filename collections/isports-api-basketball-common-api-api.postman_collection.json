          "name": "Match Modify Record",
          "request": {
            "name": "Match Modify Record",
            "description": {
              "content": "• This API endpoint returns records of schedule deletions and match time modifications from the past 24 hours. \n\n\n\n• You can use it with the <a href=\"/docs.html?id=48\" style=\"color:blue\">Schedule & Results (Basic)</a> endpoint to keep locally stored match data in sync.\n\n\n\n• Tips: You have access to all the basketball Common API endpoints with any valid paid basketball plans.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sport",
                "basketball",
                "schedule",
                "modify"
              ],
              "host": [
