        {
          "id": "9428b2a0-5d32-4886-9b9e-09d492cfd710",
          "name": "Schedule & Results (Basic)",
          "request": {
            "name": "Schedule & Results (Basic)",
            "description": {
              "content": "This API endpoint returns the basic information of the match. If you need more details, please refer to <a target=\"_blank\" href=\"/docs.html?id=21\" style=\"color:blue\">Schedule & Results</a>. You can use it with the <a href=\"/docs.html?id=33\" style=\"color:blue\">Match Modify Record</a> endpoint.\n\n\n\nTips: You have access to all the football Common API endpoints with any valid paid football plans.\n\nThe request path needs at least one parameter (date, leagueId, and matchId ) to retrieve correct response. These three parameters can not be used at the same time.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sport",
                "football",
                "schedule",
                "basic"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<string>",
                  "description": "Match date in yyyy-MM-dd format (GMT+0), e.g. 2026-05-01. Returns all matches on that date. Historical data is limited to the past month."
                },
                {
                  "disabled": false,
                  "key": "leagueId",
                  "value": "<string>",
                  "description": "Filter matches by league or cup ID. Returns the current season by default."
                },
                {
                  "disabled": false,
                  "key": "season",
                  "value": "<string>",
                  "description": "Filter by season; must be used with leagueId. e.g. 2025-2026. Defaults to current season if omitted."
                },
                {
                  "disabled": false,
                  "key": "matchId",
                  "value": "<string>",
                  "description": "Fetch one or more specific matches by ID. Separate multiple IDs with commas. Maximum 100 IDs per request."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
